    <style>
        /* =====================================================
           DOCUMENTATION PAGE
           ===================================================== */

        .docs-page {
            min-height: calc(100svh - var(--header-height, 72px));
            padding: 48px 0 72px;
        }

        /* -----------------------------------------------------
           Header
           ----------------------------------------------------- */

        .docs-header {
            max-width: 760px;
            margin-bottom: 42px;
        }

        .docs-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            color: var(--color-accent-cyan);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .docs-kicker::before {
            content: "";
            width: 6px;
            height: 6px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: var(--color-accent-cyan);
            box-shadow: 0 0 10px rgba(32, 217, 255, 0.45);
        }

        .docs-header h1 {
            margin: 0 0 10px;
            color: var(--color-text-primary);
            font-size: clamp(32px, 4vw, 42px);
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.025em;
        }

        .docs-header p {
            max-width: 700px;
            margin: 0;
            color: var(--color-text-secondary);
            font-size: 16px;
            line-height: 1.65;
        }

        /* -----------------------------------------------------
           Documentation Grid
           ----------------------------------------------------- */

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .docs-card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 210px;
            padding: 26px 24px 22px;
            background: var(--color-bg-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            transition:
                border-color var(--transition-fast),
                transform var(--transition-fast),
                box-shadow var(--transition-fast);
        }

        .docs-card:hover {
            border-color: var(--color-border-gold);
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

        .docs-card:focus-within {
            border-color: var(--color-accent-gold);
            box-shadow:
                0 0 0 2px var(--color-accent-gold-dim),
                var(--shadow-sm);
        }

        .docs-card-anchor {
            position: absolute;
            inset: 0;
            z-index: 1;
            border-radius: inherit;
            outline: none;
        }

        .docs-card-anchor:focus-visible {
            outline: 2px solid var(--color-accent-gold);
            outline-offset: -3px;
        }

        .docs-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
        }

        .docs-card-index {
            color: var(--color-text-muted);
            font-family:
                "SFMono-Regular",
                Consolas,
                "Liberation Mono",
                monospace;
            font-size: 11px;
            letter-spacing: 0.08em;
        }

        .docs-card-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            color: var(--color-accent-gold);
            background: var(--color-accent-gold-dim);
            border: 1px solid var(--color-border-gold);
            border-radius: 10px;
        }

        .docs-card-icon svg {
            width: 19px;
            height: 19px;
            stroke: currentColor;
        }

        .docs-card h2 {
            position: relative;
            z-index: 2;
            margin: 0 0 7px;
            color: var(--color-text-primary);
            font-size: 18px;
            font-weight: 650;
            line-height: 1.3;
        }

        .docs-card p {
            position: relative;
            z-index: 2;
            max-width: 500px;
            margin: 0 0 20px;
            color: var(--color-text-secondary);
            font-size: 14px;
            line-height: 1.65;
        }

        .docs-card-footer {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: auto;
        }

        /* -----------------------------------------------------
           Status Badges
           ----------------------------------------------------- */

        .docs-badge {
            display: inline-flex;
            align-items: center;
            min-height: 24px;
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            font-size: 11px;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
        }

        .docs-badge-stable {
            background: var(--color-accent-gold-dim);
            color: var(--color-accent-gold);
        }

        .docs-badge-alpha {
            background: var(--color-accent-cyan-dim);
            color: var(--color-accent-cyan);
        }

        .docs-badge-soon {
            background: var(--color-bg-surface-light);
            color: var(--color-text-muted);
        }

        .docs-card-arrow {
            color: var(--color-text-muted);
            font-size: 16px;
            transition:
                color var(--transition-fast),
                transform var(--transition-fast);
        }

        .docs-card:hover .docs-card-arrow {
            color: var(--color-accent-gold);
            transform: translateX(3px);
        }

        /* -----------------------------------------------------
           Architecture Section
           ----------------------------------------------------- */

        .docs-architecture {
            margin-top: 42px;
        }

        .docs-section-header {
            margin-bottom: 16px;
        }

        .docs-section-header h2 {
            margin: 0 0 5px;
            color: var(--color-text-primary);
            font-size: 20px;
            font-weight: 650;
        }

        .docs-section-header p {
            margin: 0;
            color: var(--color-text-muted);
            font-size: 13px;
            line-height: 1.5;
        }

        .docs-flow {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 10px;
        }

        .docs-flow-step {
            position: relative;
            min-width: 0;
            padding: 18px;
            background: var(--color-bg-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
        }

        .docs-flow-step::after {
            content: "→";
            position: absolute;
            top: 50%;
            right: -9px;
            z-index: 2;
            color: var(--color-accent-cyan);
            font-size: 14px;
            transform: translateY(-50%);
        }

        .docs-flow-step:last-child::after {
            display: none;
        }

        .docs-flow-number {
            display: block;
            margin-bottom: 10px;
            color: var(--color-accent-cyan);
            font-family:
                "SFMono-Regular",
                Consolas,
                monospace;
            font-size: 11px;
        }

        .docs-flow-step strong {
            display: block;
            margin-bottom: 5px;
            color: var(--color-text-primary);
            font-size: 14px;
        }

        .docs-flow-step span {
            display: block;
            color: var(--color-text-muted);
            font-size: 12px;
            line-height: 1.5;
        }

        /* -----------------------------------------------------
           Documentation Notice
           ----------------------------------------------------- */

        .docs-notice {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 28px;
            margin-top: 42px;
            padding: 28px;
            background:
                linear-gradient(
                    135deg,
                    var(--color-bg-surface),
                    var(--color-bg-surface-light)
                );
            border: 1px solid var(--color-border-gold);
            border-radius: var(--radius-md);
        }

        .docs-notice h2 {
            margin: 0 0 7px;
            color: var(--color-text-primary);
            font-size: 20px;
            font-weight: 650;
        }

        .docs-notice p {
            max-width: 650px;
            margin: 0;
            color: var(--color-text-secondary);
            font-size: 14px;
            line-height: 1.6;
        }

        .docs-notice-action {
            flex: 0 0 auto;
        }

        .docs-notice-action .btn {
            white-space: nowrap;
        }

        /* -----------------------------------------------------
           Responsive
           ----------------------------------------------------- */

        @media (max-width: 900px) {
            .docs-grid {
                grid-template-columns: 1fr;
            }

            .docs-flow {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .docs-flow-step::after {
                display: none;
            }

            .docs-notice {
                grid-template-columns: 1fr;
            }

            .docs-notice-action {
                width: fit-content;
            }
        }

        @media (max-width: 640px) {
            .docs-page {
                padding: 36px 0 56px;
            }

            .docs-header {
                margin-bottom: 32px;
            }

            .docs-header h1 {
                font-size: 30px;
            }

            .docs-header p {
