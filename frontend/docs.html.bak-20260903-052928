            }

            .docs-notice {
                padding: 22px 20px;
            }

            .docs-notice-action,
            .docs-notice-action .btn {
                width: 100%;
            }
        }

        @media (max-width: 480px) {
            .docs-page {
                padding-top: 32px;
            }

            .docs-card-top {
                margin-bottom: 15px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .docs-card,
            .docs-card-arrow {
                transition: none;
            }

            .docs-card:hover {
                transform: none;
            }
        }
    </style>
